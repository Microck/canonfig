{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/agent/**/*.ts",
    "src/cli/**/*.ts",
    "src/domain/**/*.ts",
    "src/enrollment/**/*.ts",
    "src/harness-configuration/**/*.ts",
    "src/machine/**/*.ts",
    "src/profile/**/*.ts",
    "src/runtime/**/*.ts",
    "src/schedule/**/*.ts",
    "src/state/**/*.ts",
    "src/synchronization/**/*.ts"
  ],
  "exclude": ["src/index.ts"]
}
