{
  "platform": "windows",
  "mechanism": "task-scheduler",
  "serviceName": "Canonfig\\canonfig-sync",
  "service": "$Action = New-ScheduledTaskAction -Execute 'C:\\Program Files\\Canonfig\\canonfig.exe' -Argument 'sync --apply --no-input'\r\n$Principal = New-ScheduledTaskPrincipal -UserId $env:USERNAME -LogonType Interactive\r\n$Settings = New-ScheduledTaskSettingsSet -ExecutionTimeLimit (New-TimeSpan -Hours 1)",
  "schedule": "$Trigger = New-ScheduledTaskTrigger -Weekly -DaysOfWeek Sun -At '23:45'\r\nRegister-ScheduledTask -TaskName 'Canonfig\\canonfig-sync' -Description 'Canonfig follower synchronization [canonfig:9ccfd0b5c3fd57ffabbfc4566b833eee1a9318dfc72ea6e31e4058af93fad197]' -Action $Action -Trigger $Trigger -Principal $Principal -Settings $Settings"
}
